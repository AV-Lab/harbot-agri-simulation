<?xml version="1.0"?>
<package format="2">
  <name>realsense_d435_gazebo</name>
  <version>0.1.0</version>
  <description>Gazebo models and plugins for Intel RealSense D435 and D435i cameras</description>
  <maintainer email="michele.tartari@iit.it">m-tartari</maintainer>
  <author email="michele.tartari@iit.it">m-tartari</author>
  <license>Apache 2.0</license>
  
  <buildtool_depend>catkin</buildtool_depend>
  <depend>roscpp</depend>
  <depend>gazebo_ros</depend>
  <depend>sensor_msgs</depend>
  <depend>image_transport</depend>
  <depend>camera_info_manager</depend>

  <!-- The export tag contains other, unspecified, tags -->
  <export>
    <gazebo_ros plugin_path="${prefix}/lib"/>
  </export>
</package>