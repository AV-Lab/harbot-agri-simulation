<?xml version="1.0"?>
<robot name="rbkairos" xmlns:xacro="http://wiki.ros.org/xacro">

  <!-- ***************** -->
  <!-- Imported elements -->
  <!-- ***************** -->

  <!-- Use the same RBKAIROS base composition as the UR variants -->
  <xacro:include filename="$(find harbot_description)/urdf/base/rbkairos/rbkairos_base.urdf.xacro" />

  <!-- Include Franka arm macro wrapper -->
  <xacro:include filename="$(find harbot_description)/urdf/arms/franka/franka_robot_arm.xacro" />

  <xacro:include filename="$(find realsense_d435_gazebo)/urdf/_d435.urdf.xacro"/>

  <!-- Flag to select the high or low quality model -->
  <xacro:property name="hq" value="true" />

  <xacro:arg name="prefix" default="robot_"/>
  <xacro:arg name="ros_planar_move_plugin" default="false"/>
  <xacro:arg name="launch_arm" default="true"/>
  <xacro:arg name="launch_gripper" default="true"/>
  <xacro:arg name="gripper" default="six"/>
  <xacro:arg name="launch_camera" default="true"/>
  <xacro:arg name="arm_id" default="panda" />

  <xacro:property name="PI" value="3.1415926535897931"/>

  <!-- Franka mounting pose on RBKAIROS base -->
  <xacro:property name="arm_position_x" value="0.1883"/>
  <xacro:property name="arm_position_y" value="0"/>
  <xacro:property name="arm_position_z" value="0.38212"/>
  <xacro:property name="arm_orientation_r" value="0"/>
  <xacro:property name="arm_orientation_p" value="0"/>
  <xacro:property name="arm_orientation_y" value="${-PI}"/>

  <xacro:macro name="rbkairos_franka" params="prefix publish_bf hq">

    <!-- RBKAIROS base -->
    <xacro:rbkairos_base prefix="$(arg prefix)" publish_bf="true" hq="true" use_omni_wheels="$(arg ros_planar_move_plugin)"/>

    <xacro:if value="$(arg launch_arm)">
      <!-- Franka ARM -->
      <xacro:franka_robot
        arm_id="$(arg arm_id)"
        parent="$(arg prefix)base_link"
        xyz="${arm_position_x} ${arm_position_y} ${arm_position_z}"
        rpy="${arm_orientation_r} ${arm_orientation_p} ${arm_orientation_y}"
        joint_limits="${xacro.load_yaml('$(find harbot_description)/config/arms/franka/joint_limits.yaml')}"/>

        <xacro:if value="$(arg launch_camera)">
          <xacro:sensor_d435
            parent="$(arg arm_id)_gripper_adapter_plate"
            name="$(arg arm_id)_wrist_d435"
            topics_ns="$(arg arm_id)_wrist_d435"
            align_depth="true"
            enable_pointCloud="true"
            visualize="false">
            <origin xyz="0.035 0.043 0.0" rpy="${-PI/2} ${-PI/1} 0"/>
          </xacro:sensor_d435>
        </xacro:if>
        
    </xacro:if>

    <!-- Gazebo ros control plugins -->
    <xacro:ros_control/>
    <xacro:if value="$(arg ros_planar_move_plugin)">
      <xacro:omni_steering prefix="$(arg prefix)" publish_tf="true"/>
    </xacro:if>
  </xacro:macro>

  <xacro:rbkairos_franka prefix="$(arg prefix)" publish_bf="true" hq="true"/>

</robot>
