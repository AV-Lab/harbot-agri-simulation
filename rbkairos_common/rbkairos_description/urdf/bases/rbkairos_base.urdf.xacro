<?xml version="1.0"?>
<robot name="rbkairos" xmlns:xacro="http://wiki.ros.org/xacro">

  	<!-- ***************** -->
  	<!-- Imported elements -->
  	<!-- ***************** -->

  	<!-- First we import all posible elements defined in the urdf.xacro files. All these elements are defined as macro:xacros -->

  	<!-- Import summit XL base elements -->
  	<xacro:include filename="$(find summit_xl_description)/urdf/bases/summit_xls_base.urdf.xacro" />

  	<!-- Import summit XL wheels -->
  	<xacro:include filename="$(find summit_xl_description)/urdf/wheels/omni_wheel.urdf.xacro" />
  	<xacro:include filename="$(find summit_xl_description)/urdf/wheels/rubber_wheel.urdf.xacro" />
  	<xacro:include filename="$(find summit_xl_description)/urdf/structures/structure_hokuyo.urdf.xacro" />

  	<!-- Import all available sensors -->
  	<xacro:include filename="$(find robotnik_sensors)/urdf/all_sensors.urdf.xacro" />

  	<xacro:property name="PI" value="3.1415926535897931"/>

  	<!-- Wheel parameters -->
  	<!-- Wheel parameters -->
  	<xacro:property name="wheel_offset_x" value="0.2225" />    <!-- x,y,z in translation from base_link to the center of the wheel -->
  	<xacro:property name="wheel_offset_y" value="0.2045" />
  	<xacro:property name="wheel_offset_z" value="0.0" />

  	<xacro:property name="front_laser_offset_x" value="0.2865"/>
  	<xacro:property name="front_laser_offset_y" value="-0.20894"/>
  	<xacro:property name="front_laser_offset_z" value="0.2973"/>

  	<xacro:property name="rear_laser_offset_x" value="-0.2865"/>
  	<xacro:property name="rear_laser_offset_y" value="0.20894"/>
  	<xacro:property name="rear_laser_offset_z" value="0.2973"/>

  	<xacro:property name="front_ptz_camera_offset_x" value="0.308"/>
  	<xacro:property name="front_ptz_camera_offset_y" value="0.141"/>
  	<xacro:property name="front_ptz_camera_offset_z" value="0.195"/>

  	<xacro:property name="rear_ptz_camera_offset_x" value="-0.308"/>
  	<xacro:property name="rear_ptz_camera_offset_y" value="-0.141"/>
  	<xacro:property name="rear_ptz_camera_offset_z" value="0.195"/>

    <xacro:property name="imu_offset_x" value="0.127"/>
  	<xacro:property name="imu_offset_y" value="-0.129"/>
  	<xacro:property name="imu_offset_z" value="0.212"/>

  	<xacro:property name="front_rgbd_camera_offset_x" value="0.35850"/>
  	<xacro:property name="front_rgbd_camera_offset_y" value="0.0"/>
  	<xacro:property name="front_rgbd_camera_offset_z" value="0.25062"/>

	<xacro:property name="third_person_camera_offset_x" value="-2.2"/>
  	<xacro:property name="third_person_camera_offset_y" value="0.0"/>
  	<xacro:property name="third_person_camera_offset_z" value="1.35"/>
  	<xacro:property name="third_person_camera_pitch" value="0.35"/>

  	<xacro:property name="gps_offset_x" value="-0.365"/>
  	<xacro:property name="gps_offset_y" value="-0.167"/>
  	<xacro:property name="gps_offset_z" value="0.302"/>

  	<!-- Flag to select the high or low quality model -->
  	<xacro:property name="hq" value="true" />

  	<xacro:arg name="prefix" default="summit_xl_"/>
  	<xacro:arg name="ros_planar_move_plugin" default="false"/>


    <xacro:macro name="rbkairos_base" params="prefix publish_bf hq gpu:=false use_omni_wheels:=false">

  		<!-- *************** -->
  		<!-- Robots Elements -->
  		<!-- *************** -->

  		<!-- Here we create the robot elements using the xacro:macros imported at the beggining of this file -->

  		<!-- Summit XL base -->
  		<xacro:summit_xls_base prefix="$(arg prefix)" publish_bf="true" hq="${hq}" />

  		<joint name="$(arg prefix)container_joint" type="fixed">
  			<origin xyz="-0.3595 0 0.204123" rpy="0 0 0"/>
  			<parent link="$(arg prefix)base_link"/>
  			<child link="$(arg prefix)container_link"/>
  		</joint>

  		<link name="$(arg prefix)container_link">
  			<inertial>
  				<mass value="0.001"/>
  				<origin xyz="0 0 0" rpy="0 0 0"/>
  				<inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
  			</inertial>
			<visual>
  				<origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
  				<geometry>
  					<mesh filename="package://rbkairos_description/meshes/structures/container.obj"/>
  				</geometry>
			</visual>
  			<collision>
  				<origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
  				<geometry>
  					<mesh filename="package://rbkairos_description/meshes/structures/container.obj"/>
  				</geometry>
  			</collision>
  		</link>

		<joint name="$(arg prefix)container_side_joint" type="fixed">
  			<origin xyz="-0.3595 0 0.204123" rpy="0 0 0"/>
  			<parent link="$(arg prefix)base_link"/>
  			<child link="$(arg prefix)container_side_link"/>
  		</joint>

  		<link name="$(arg prefix)container_side_link">
  			<inertial>
  				<mass value="0.001"/>
  				<origin xyz="0 0 0" rpy="0 0 0"/>
  				<inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
  			</inertial>
			<visual>
  				<origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
  				<geometry>
  					<mesh filename="package://rbkairos_description/meshes/structures/container_side.obj"/>
  				</geometry>
			</visual>
  			<collision>
  				<origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
  				<geometry>
  					<mesh filename="package://rbkairos_description/meshes/structures/container_side.obj"/>
  				</geometry>
  			</collision>
  		</link>

		<joint name="$(arg prefix)container_bottom_joint" type="revolute">
  			<origin xyz="-0.3715 0 0.204123" rpy="0 0 0"/>
  			<parent link="$(arg prefix)base_link"/>
  			<child link="$(arg prefix)container_bottom_link"/>
			<axis xyz="0 -1 0"/>
			<limit lower="0" upper="0.7854" effort="150" velocity="0.5"/>
 		    <dynamics damping="8.0" friction="12.0"/>
  		</joint>

  		<link name="$(arg prefix)container_bottom_link">
  			<inertial>
  				<mass value="1.5"/>
  				<origin xyz="0 0 0" rpy="0 0 0"/>
  				<inertia ixx="0.020" ixy="0.0" ixz="0.0" iyy="0.070" iyz="0.0" izz="0.090"/>
  			</inertial>
  			<visual>
  				<origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
  				<geometry>
  					<mesh filename="package://rbkairos_description/meshes/structures/container_bottom.obj"/>
  				</geometry>
			</visual>
  			<collision>
  				<origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
  				<geometry>
  					<mesh filename="package://rbkairos_description/meshes/structures/container_bottom.obj"/>
  				</geometry>
  			</collision>
  		</link>		

		<transmission name="$(arg prefix)container_bottom_trans">
			<type>transmission_interface/SimpleTransmission</type>
			<joint name="$(arg prefix)container_bottom_joint">
				<hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
			</joint>
			<actuator name="$(arg prefix)container_bottom_motor">
				<hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
				<mechanicalReduction>1</mechanicalReduction>
			</actuator>
		</transmission>

  		<xacro:if value="${use_omni_wheels}">
  			<xacro:omni_wheel prefix="$(arg prefix)front_right" parent="$(arg prefix)base_link" reflect="false" hq="${hq}">
  				<origin xyz="${wheel_offset_x} -${wheel_offset_y} ${wheel_offset_z}" rpy="0 0 0"/>
  			</xacro:omni_wheel>

  			<xacro:omni_wheel prefix="$(arg prefix)front_left" parent="$(arg prefix)base_link" reflect="true" hq="${hq}">
  				<origin xyz="${wheel_offset_x} ${wheel_offset_y} ${wheel_offset_z}" rpy="0 0 0"/>
  			</xacro:omni_wheel>

  			<xacro:omni_wheel prefix="$(arg prefix)back_left" parent="$(arg prefix)base_link" reflect="true" hq="${hq}">
  				<origin xyz="-${wheel_offset_x} ${wheel_offset_y} ${wheel_offset_z}" rpy="0 0 0"/>
  			</xacro:omni_wheel>

  			<xacro:omni_wheel prefix="$(arg prefix)back_right" parent="$(arg prefix)base_link" reflect="false" hq="${hq}">
  				<origin xyz="-${wheel_offset_x} -${wheel_offset_y} ${wheel_offset_z}" rpy="0 0 0"/>
  			</xacro:omni_wheel>
  		</xacro:if>

  		<xacro:unless value="${use_omni_wheels}">
  			<xacro:rubber_wheel prefix="$(arg prefix)front_right" parent="$(arg prefix)base_link" reflect="false" hq="${hq}">
  				<origin xyz="${wheel_offset_x} -${wheel_offset_y} ${wheel_offset_z}" rpy="0 0 0"/>
  			</xacro:rubber_wheel>

  			<xacro:rubber_wheel prefix="$(arg prefix)front_left" parent="$(arg prefix)base_link" reflect="true" hq="${hq}">
  				<origin xyz="${wheel_offset_x} ${wheel_offset_y} ${wheel_offset_z}" rpy="0 0 0"/>
  			</xacro:rubber_wheel>

  			<xacro:rubber_wheel prefix="$(arg prefix)back_left" parent="$(arg prefix)base_link" reflect="true" hq="${hq}">
  				<origin xyz="-${wheel_offset_x} ${wheel_offset_y} ${wheel_offset_z}" rpy="0 0 0"/>
  			</xacro:rubber_wheel>

  			<xacro:rubber_wheel prefix="$(arg prefix)back_right" parent="$(arg prefix)base_link" reflect="false" hq="${hq}">
  				<origin xyz="-${wheel_offset_x} -${wheel_offset_y} ${wheel_offset_z}" rpy="0 0 0"/>
  			</xacro:rubber_wheel>
  		</xacro:unless>

		<!-- IMU -->
  		<xacro:sensor_imu_hector prefix="$(arg prefix)imu" parent="$(arg prefix)base_link">
  			<origin xyz="${imu_offset_x} ${imu_offset_y} ${imu_offset_z}" rpy="0 0 0"/>
  		</xacro:sensor_imu_hector>

  		<!-- SENSORS -->
  		<xacro:sensor_sick_s300 prefix="$(arg prefix)front_laser" parent="$(arg prefix)base_link" prefix_topic="front_laser" gpu="${gpu}">
  			<origin xyz="${front_laser_offset_x} ${front_laser_offset_y} ${front_laser_offset_z}" rpy="0 ${-PI} ${3/4*PI}" />
  		</xacro:sensor_sick_s300>
  		<xacro:sensor_sick_s300 prefix="$(arg prefix)rear_laser" parent="$(arg prefix)base_link" prefix_topic="rear_laser" gpu="${gpu}">
  			<origin xyz="${rear_laser_offset_x} ${rear_laser_offset_y} ${rear_laser_offset_z}" rpy="0 ${-PI} ${-1/4*PI}" />
  		</xacro:sensor_sick_s300>


  		<xacro:sensor_orbbec_astra prefix="$(arg prefix)front_rgbd_camera" parent="$(arg prefix)base_link" prefix_topic="front_rgbd_camera">
  			<origin xyz="${front_rgbd_camera_offset_x} ${front_rgbd_camera_offset_y} ${front_rgbd_camera_offset_z}" rpy="0 0 0"/>
  		</xacro:sensor_orbbec_astra>

  		<joint name="$(arg prefix)third_person_camera_joint" type="fixed">
  			<origin xyz="${third_person_camera_offset_x} ${third_person_camera_offset_y} ${third_person_camera_offset_z}" rpy="0 ${third_person_camera_pitch} 0"/>
  			<parent link="$(arg prefix)base_link"/>
  			<child link="$(arg prefix)third_person_camera_link"/>
  		</joint>

  		<link name="$(arg prefix)third_person_camera_link">
  			<inertial>
  				<mass value="0.05"/>
  				<origin xyz="0 0 0" rpy="0 0 0"/>
  				<inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
  			</inertial>
  		</link>

  		<gazebo reference="$(arg prefix)third_person_camera_link">
  			<material>Gazebo/Black</material>
  			<sensor type="camera" name="$(arg prefix)third_person_camera_sensor">
				<always_on>true</always_on>
				<update_rate>60.0</update_rate>
				<camera>
					<horizontal_fov>${70.0*PI/180.0}</horizontal_fov>
					<image>
					<width>1960</width>
					<height>1080</height>
					<format>R8G8B8</format>
					</image>
					<clip>
					<near>0.05</near>
					<far>50.0</far>
					</clip>
				</camera>
				<plugin name="$(arg prefix)third_person_camera_controller" filename="libgazebo_ros_camera.so">
					<alwaysOn>true</alwaysOn>
					<updateRate>60.0</updateRate>
					<cameraName>third_person_camera</cameraName>
					<imageTopicName>image_raw</imageTopicName>
					<cameraInfoTopicName>camera_info</cameraInfoTopicName>
					<frameName>$(arg prefix)third_person_camera_link</frameName>
				</plugin>
			</sensor>
  		</gazebo>


     </xacro:macro>

</robot>
