<?xml version="1.0"?>
<launch>
  <arg name="prefix" default="robot_" />
  <arg name="arm_id" default="$(eval arg('prefix')[:-1] if arg('prefix').endswith('_') else arg('prefix'))" />

  <!-- Load joint controller configurations from YAML file to parameter server -->
  <rosparam file="$(find rbkairos_franka_moveit_config)/config/ros_controllers.yaml" command="load" subst_value="true"/>

  <!-- Load the controllers -->
  <node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false"
    output="screen" args="arm_controller "/>

</launch>
