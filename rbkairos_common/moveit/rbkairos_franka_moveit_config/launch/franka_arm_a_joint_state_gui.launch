<launch>
  <arg name="robot_ns" default="robot"/>
  <arg name="arm_id" default="robot"/>
  <arg name="robot_model" default="fr3"/>
  <arg name="hand" default="false"/>
  <arg name="publish_rate" default="30"/>

  <arg name="use_rviz" default="true"/>
  <arg name="rviz_config" default="$(dirname)/franka_arm_a_joint_state_gui.rviz"/>
  <arg name="fixed_frame" default="$(arg robot_ns)_base_link"/>

  <arg name="feedback_joint_states_topic" default="/$(arg robot_ns)/joint_states"/>
  <arg name="gui_joint_states_topic" default="franka_arm_gui_joint_states"/>
  <arg name="command_topic" default="arm/pos_traj_controller/command"/>
  <arg name="trajectory_duration" default="0.6"/>
  <arg name="deadband" default="0.003"/>
  <arg name="sync_tolerance" default="0.08"/>
  <arg name="min_publish_period" default="0.08"/>
  <arg name="initialize_from_current" default="true"/>

  <group ns="$(arg robot_ns)">
    <node
      name="franka_arm_joint_state_publisher_gui"
      pkg="joint_state_publisher_gui"
      type="joint_state_publisher_gui"
      output="screen">
      <param
        name="robot_description"
        command="$(find xacro)/xacro '$(find franka_description)/robots/$(arg robot_model)/$(arg robot_model).urdf.xacro' arm_id:=$(arg arm_id) hand:=$(arg hand) gazebo:=false"/>
      <param name="rate" value="$(arg publish_rate)"/>

      <param if="$(arg initialize_from_current)" name="zeros/$(arg arm_id)_joint1" command="$(find rbkairos_franka_moveit_config)/launch/get_joint_position.py $(arg feedback_joint_states_topic) $(arg arm_id)_joint1"/>
      <param if="$(arg initialize_from_current)" name="zeros/$(arg arm_id)_joint2" command="$(find rbkairos_franka_moveit_config)/launch/get_joint_position.py $(arg feedback_joint_states_topic) $(arg arm_id)_joint2"/>
      <param if="$(arg initialize_from_current)" name="zeros/$(arg arm_id)_joint3" command="$(find rbkairos_franka_moveit_config)/launch/get_joint_position.py $(arg feedback_joint_states_topic) $(arg arm_id)_joint3"/>
      <param if="$(arg initialize_from_current)" name="zeros/$(arg arm_id)_joint4" command="$(find rbkairos_franka_moveit_config)/launch/get_joint_position.py $(arg feedback_joint_states_topic) $(arg arm_id)_joint4"/>
      <param if="$(arg initialize_from_current)" name="zeros/$(arg arm_id)_joint5" command="$(find rbkairos_franka_moveit_config)/launch/get_joint_position.py $(arg feedback_joint_states_topic) $(arg arm_id)_joint5"/>
      <param if="$(arg initialize_from_current)" name="zeros/$(arg arm_id)_joint6" command="$(find rbkairos_franka_moveit_config)/launch/get_joint_position.py $(arg feedback_joint_states_topic) $(arg arm_id)_joint6"/>
      <param if="$(arg initialize_from_current)" name="zeros/$(arg arm_id)_joint7" command="$(find rbkairos_franka_moveit_config)/launch/get_joint_position.py $(arg feedback_joint_states_topic) $(arg arm_id)_joint7"/>

      <remap from="joint_states" to="$(arg gui_joint_states_topic)"/>
    </node>

    <node
      name="franka_arm_gui_to_controller"
      pkg="rbkairos_franka_moveit_config"
      type="franka_arm_gui_to_controller.py"
      output="screen">
      <rosparam param="joints" subst_value="true">
        - $(arg arm_id)_joint1
        - $(arg arm_id)_joint2
        - $(arg arm_id)_joint3
        - $(arg arm_id)_joint4
        - $(arg arm_id)_joint5
        - $(arg arm_id)_joint6
        - $(arg arm_id)_joint7
      </rosparam>
      <param name="input_joint_states" value="$(arg gui_joint_states_topic)"/>
      <param name="feedback_joint_states" value="$(arg feedback_joint_states_topic)"/>
      <param name="command_topic" value="$(arg command_topic)"/>
      <param name="trajectory_duration" value="$(arg trajectory_duration)"/>
      <param name="deadband" value="$(arg deadband)"/>
      <param name="sync_tolerance" value="$(arg sync_tolerance)"/>
      <param name="min_publish_period" value="$(arg min_publish_period)"/>
    </node>
  </group>

  <node
    pkg="rviz"
    type="rviz"
    name="rviz_franka_arm_a_joint_state_gui"
    args="-d $(arg rviz_config) -f $(arg fixed_frame)"
    if="$(arg use_rviz)"/>
</launch>
