    <node pkg="harbot_navigation"
          type="path_gui.py"
          name="path_gui"
          ns="/robot"
          output="screen"
          launch-prefix="bash -c 'sleep 2; exec &quot;$@&quot;' _">
        <param name="odom_topic" value="robotnik_base_control/odom_gt" />
        <param name="other_odom_topic" value="/robot_b/robotnik_base_control/odom_gt" />
        <param name="global_path_topic" value="path_nav/path" />
        <param name="desired_velocity_topic" value="path_nav/desired_speed" />
        <param name="state_flag_topic" value="path_nav/status" />
        <param name="proceed_flag_topic" value="path_nav/proceed_flag" />
        <param name="reverse_mode_topic" value="path_nav/reverse_mode" />
    </node>
    
