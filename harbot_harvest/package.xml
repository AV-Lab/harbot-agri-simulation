<?xml version="1.0"?>
<package format="2">
  <name>harbot_harvest</name>
  <version>0.0.0</version>
  <description>Perception, harvesting workflow, and PROST integration for HARBOT.</description>

  <maintainer email="s.abbashussain@outlook.com">Abbas Hussain</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <depend>harbot_control</depend>
  <exec_depend>harbot_navigation</exec_depend>
  <exec_depend>message_filters</exec_depend>
  <exec_depend>moveit_commander</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>rbkairos_etf_services</exec_depend>
  <exec_depend>rosbash</exec_depend>
  <exec_depend>roslaunch</exec_depend>
  <exec_depend>rospack</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf</exec_depend>
  <exec_depend>tf2_geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>

</package>
