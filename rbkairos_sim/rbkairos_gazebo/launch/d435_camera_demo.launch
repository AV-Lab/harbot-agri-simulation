<?xml version="1.0"?>
<launch>
  <arg name="debug" default="false"/>
  <arg name="paused" default="false"/>
  <arg name="launch_rviz" default="true"/>
  <arg name="rviz_config" default="$(find rbkairos_gazebo)/rviz/d435_camera_demo.rviz"/>
  <arg name="world" default="$(find rbkairos_gazebo)/worlds/d435_camera_demo.world"/>

  <env name="GAZEBO_MODEL_PATH" value="$(find rbkairos_gazebo)/models:$(optenv GAZEBO_MODEL_PATH)"/>
  <env name="GAZEBO_PLUGIN_PATH" value="$(find realsense_d435_gazebo)/../../devel/lib:$(optenv GAZEBO_PLUGIN_PATH)"/>

  <param name="robot_description"
         command="$(find xacro)/xacro '$(find rbkairos_gazebo)/urdf/d435_camera_demo.urdf.xacro'"/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(arg world)"/>
    <arg name="debug" value="$(arg debug)"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui" value="true"/>
    <arg name="headless" value="false"/>
  </include>

  <node name="robot_state_publisher"
        pkg="robot_state_publisher"
        type="robot_state_publisher"
        output="screen"/>

  <node if="$(arg launch_rviz)"
        name="rviz"
        pkg="rviz"
        type="rviz"
        output="screen"
        args="-d $(arg rviz_config)"/>
</launch>
