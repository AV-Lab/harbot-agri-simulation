<?xml version="1.0"?>
<launch>

    <arg name="id_robot" default="robot"/>

    <arg name="x_init_pose" default="0"/>
    <arg name="y_init_pose" default="0"/>
    <arg name="z_init_pose" default="0"/>
    <arg name="yaw_init_pose" default="0"/>

    <arg name="arm_model" default="franka"/>
    <arg name="xacro_robot" default="rbkairos_franka.urdf.xacro"/>
    <arg name="is_franka" default="$(eval arg('arm_model') == 'franka')"/>
    <arg name="ros_planar_move_plugin" default="true"/><!-- plugin to simulate omni drive -->

    <arg name="launch_arm" default="true"/>    <!-- moveit -->
    <arg name="launch_move_group" default="false"/>    <!-- moveit -->
    <arg name="moveit_pipeline" default="ompl"/>
    <arg name="launch_gripper" default="false"/>
    <arg name="launch_camera" default="false"/>
    <arg name="gripper_model" default="egh"/>

    <arg name="load_arm_kinematics_file" default="true"/>
    <arg name="launch_rviz" default="true"/>

    <!-- BEGIN ROBOT -->
    <group ns="$(arg id_robot)">

        <arg name="prefix" value="$(arg id_robot)_"/>

        <!-- Load the URDF into the ROS Parameter Server -->
        <param name="robot_description"
        command="$(find xacro)/xacro '$(find rbkairos_description)/robots/$(arg xacro_robot)' prefix:=$(arg prefix) ros_planar_move_plugin:=$(arg ros_planar_move_plugin) load_kinematics_file:=$(arg load_arm_kinematics_file) launch_arm:=$(arg launch_arm) launch_gripper:=$(arg launch_gripper) launch_camera:=$(arg launch_camera) arm_id:=$(arg id_robot)"/>

        <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" respawn="false" output="screen">
            <remap from="/joint_states" to="joint_states" />
        </node>

        <!-- Spawner model into gazebo -->
        <node if="$(eval not arg('is_franka') and arg('launch_arm'))" name="urdf_spawner_rbkairos_model" pkg="gazebo_ros" type="spawn_model" respawn="false" output="screen"
         args="-x $(arg x_init_pose)
                -y $(arg y_init_pose)
                -z $(arg z_init_pose)
                -Y $(arg yaw_init_pose)
                -J $(arg id_robot)_arm_elbow_joint -2
                -J $(arg id_robot)_arm_shoulder_lift_joint -0.785
                -J $(arg id_robot)_arm_shoulder_pan_joint -0.785
                -J $(arg id_robot)_egh_gripper_finger_left_joint 0.048
                -urdf
                -param robot_description
                -model $(arg id_robot)
                 " />

        <node if="$(eval arg('is_franka') and arg('launch_arm'))" name="urdf_spawner_rbkairos_model" pkg="gazebo_ros" type="spawn_model" respawn="false" output="screen"
         args="-x $(arg x_init_pose)
                -y $(arg y_init_pose)
                -z $(arg z_init_pose)
                -Y $(arg yaw_init_pose)
                -J $(arg id_robot)_joint1 0.0
                -J $(arg id_robot)_joint2 -0.785
                -J $(arg id_robot)_joint3 0.0
                -J $(arg id_robot)_joint4 -2.1
                -J $(arg id_robot)_joint5 0.0
                -J $(arg id_robot)_joint6 1.571
                -J $(arg id_robot)_joint7 0.785
                -J $(arg id_robot)_finger_joint1 0.5
                -urdf
                -param robot_description
                -model $(arg id_robot)
                 " />

        
        <node unless="$(arg launch_arm)" name="urdf_spawner_rbkairos_base_model" pkg="gazebo_ros" type="spawn_model" respawn="false" output="screen"
         args="-x $(arg x_init_pose)
                -y $(arg y_init_pose)
                -z $(arg z_init_pose)
                -Y $(arg yaw_init_pose)
                -urdf
                -param robot_description
                -model $(arg id_robot)
                 " />

        <!-- start rbkairos_control nodes -->
        <include file="$(find rbkairos_control)/launch/rbkairos_control.launch">
            <arg name="prefix" value="$(arg prefix)"/>
            <arg name="sim" value="true"/>

            <arg name="kinematics" value="omni"/>

            <arg name="ros_planar_move_plugin" value="$(arg ros_planar_move_plugin)"/>
            <arg name="sim_arm_control" value="$(arg launch_arm)"/>
            <arg name="sim_gripper_control" value="$(arg launch_gripper)"/>
            <arg name="arm_model" value="$(arg arm_model)"/>
            <arg name="arm_id" value="$(arg id_robot)"/>
            <arg name="arm_controllers" value="arm/pos_traj_controller"/>
            <arg unless="$(arg launch_move_group)" name="gripper_controllers" value="gripper/gripper_controller"/>
            <arg if="$(arg launch_move_group)" name="gripper_controllers" value="gripper/pos_traj_controller"/>
        </include>

        <!-- MoveGroup Moveit! -->
        <include if="$(eval arg('launch_move_group') and not arg('is_franka'))" file="$(find rbkairos_ur5_egh_moveit_config)/launch/demo.launch">
            <arg name="load_robot_description" value="false"/>
            <arg name="prefix" value="$(arg prefix)"/>
            <arg name="pipeline" value="$(arg moveit_pipeline)"/>
            <arg name="use_rviz" value="$(arg launch_rviz)"/>
        </include>
        <include if="$(eval arg('launch_move_group') and arg('is_franka'))" file="$(find rbkairos_franka_moveit_config)/launch/demo.launch">
            <arg name="load_robot_description" value="false"/>
            <arg name="prefix" value="$(arg prefix)"/>
            <arg name="fixed_frame" value="$(arg prefix)base_footprint"/>
            <arg name="pipeline" value="$(arg moveit_pipeline)"/>
            <arg name="launch_camera" value="$(arg launch_camera)"/>
            <arg name="use_rviz" value="$(arg launch_rviz)"/>
        </include>

    </group>



</launch>
