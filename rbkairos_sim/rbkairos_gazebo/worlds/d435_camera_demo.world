<?xml version="1.0"?>
<sdf version="1.6">
  <world name="d435_camera_demo">
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <uri>model://sun</uri>
    </include>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>2.2 -2.0 1.4 0 0.35 2.35</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <model name="depth_target_box">
      <static>true</static>
      <pose>1.25 0.0 0.45 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.35 0.55 0.35</size>
            </box>
          </geometry>
          <material>
            <ambient>0.95 0.38 0.08 1</ambient>
            <diffuse>0.95 0.38 0.08 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.35 0.55 0.35</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <model name="depth_target_sphere">
      <static>true</static>
      <pose>1.9 -0.35 0.55 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>0.22</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.05 0.45 0.95 1</ambient>
            <diffuse>0.05 0.45 0.95 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <sphere>
              <radius>0.22</radius>
            </sphere>
          </geometry>
        </collision>
      </link>
    </model>
  </world>
</sdf>
