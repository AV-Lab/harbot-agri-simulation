<?xml version="1.0"?>
<launch>

    <!-- arg to config the launch file-->

    <arg name="launch_rviz" default="false"/>
    <arg name="gazebo_world" default="$(find rbkairos_gazebo)/worlds/greenhouse.world"/>
    <arg name="default_arm_model" default="franka"/>
    <arg name="default_gripper_model" default="egh"/>
    <arg name="default_xacro" default="$(eval 'rbkairos_franka.urdf.xacro' if arg('default_arm_model') == 'franka' else 'versions/rbkairos_{}_{}.urdf.xacro'.format(arg('default_arm_model'), arg('default_gripper_model')))"/>
    <arg name="omni_drive" default="true"/>
    <!-- Needed if using ur_description from fmauch_universal_robot -->
    <arg name="load_arm_kinematics_file" default="false"/>
    <arg name="launch_gt_odom_tf" default="true"/>

    <arg name="gt_odom_world_frame" default="world"/>
    <arg name="gt_odom_rate" default="30.0"/>

    <!-- arguments robot a -->
    <arg name="id_robot_a" default="robot"/>
    <arg name="launch_robot_a" default="true"/>
    <arg name="xacro_robot_a" default="$(arg default_xacro)"/>
    <arg name="waypoint_robot_a" default=""/>
    <!-- spawn position robot a -->
    <arg name="x_init_pose_robot_a" default="$(eval {'a1': -7.5, 'a2': -7.5, 'a3': -7.5, 'a4': -7.5, 'a5': -7.5, 'a6': -7.5, 'a7': -7.5, 'a8': -7.5, 'a16': -4.0, 'a15': -4.0, 'a14': -4.0, 'a13': -4.0, 'a12': -4.0, 'a11': -4.0, 'a10': -4.0, 'a9': -4.0, 'a17': 0.0, 'a18': 0.0, 'a19': 0.0, 'a20': 0.0}.get(arg('waypoint_robot_a').lower(), -7.5))" />
    <arg name="y_init_pose_robot_a" default="$(eval {'a1': -12.0, 'a2': -8.559429, 'a3': -5.118858, 'a4': -1.678287, 'a5': 1.762284, 'a6': 5.202855, 'a7': 8.643426, 'a8': 12.083997, 'a16': 12.083997, 'a15': 8.643426, 'a14': 5.202855, 'a13': 1.762284, 'a12': -1.678287, 'a11': -5.118858, 'a10': -8.559429, 'a9': -12.0, 'a17': -12.0, 'a18': -8.559429, 'a19': -5.118858, 'a20': -1.678287}.get(arg('waypoint_robot_a').lower(), -12.0))" />
    <arg name="z_init_pose_robot_a" default="0.1" />
    <arg name="yaw_init_pose_robot_a"  default="$(eval {'a1': 1.5708, 'a2': 1.5708, 'a3': 1.5708, 'a4': 1.5708, 'a5': 1.5708, 'a6': 1.5708, 'a7': 1.5708, 'a8': 1.5708, 'a16': -1.5708, 'a15': -1.5708, 'a14': -1.5708, 'a13': -1.5708, 'a12': -1.5708, 'a11': -1.5708, 'a10': -1.5708, 'a9': -1.5708, 'a17': 1.5708, 'a18': 1.5708, 'a19': 1.5708, 'a20': 1.5708}.get(arg('waypoint_robot_a').lower(), 1.5708))" />
    <!-- arm robot a -->
    <arg name="launch_arm_a" default="true"/>
    <arg name="arm_model_a" default="$(arg default_arm_model)"/>
    <arg name="moveit_movegroup_a" default="true"/>
    <arg name="moveit_pipeline_a" default="ompl"/>
    <!-- gripper robot a -->
    <arg name="launch_gripper_a" default="true"/>
    <arg name="launch_camera_a" default="true"/>
    <arg name="gripper_model_a" default="$(arg default_gripper_model)"/>
    <arg name="gt_odom_topic_a" default="/$(arg id_robot_a)/robotnik_base_control/odom_gt"/>
    <arg name="gt_odom_frame_a" default="$(arg id_robot_a)_odom"/>
    <arg name="gt_base_frame_a" default="$(arg id_robot_a)_base_footprint"/>

    <!-- arguments robot b -->
    <arg name="id_robot_b" default="robot_b"/>
    <arg name="launch_robot_b" default="true"/>
    <arg name="xacro_robot_b" default="$(arg default_xacro)"/>
    <arg name="waypoint_robot_b" default="a40"/>
    <!-- spawn position robot b -->
    <arg name="x_init_pose_robot_b" default="$(eval {'a40': 7.5, 'a39': 7.5, 'a38': 7.5, 'a37': 7.5, 'a36': 7.5, 'a35': 7.5, 'a34': 7.5, 'a33': 7.5, 'a25': 4.0, 'a26': 4.0, 'a27': 4.0, 'a28': 4.0, 'a29': 4.0, 'a30': 4.0, 'a31': 4.0, 'a32': 4.0, 'a24': 0.0, 'a23': 0.0, 'a22': 0.0, 'a21': 0.0}.get(arg('waypoint_robot_b').lower(), 7.5))" />
    <arg name="y_init_pose_robot_b" default="$(eval {'a40': 12.083997, 'a39': 8.643426, 'a38': 5.202855, 'a37': 1.762284, 'a36': -1.678287, 'a35': -5.118858, 'a34': -8.559429, 'a33': -12.0, 'a25': -12.0, 'a26': -8.559429, 'a27': -5.118858, 'a28': -1.678287, 'a29': 1.762284, 'a30': 5.202855, 'a31': 8.643426, 'a32': 12.083997, 'a24': 12.083997, 'a23': 8.643426, 'a22': 5.202855, 'a21': 1.762284}.get(arg('waypoint_robot_b').lower(), 12.083997))" />
    <arg name="z_init_pose_robot_b" default="0.1" />
    <arg name="yaw_init_pose_robot_b" default="$(eval {'a40': -1.5708, 'a39': -1.5708, 'a38': -1.5708, 'a37': -1.5708, 'a36': -1.5708, 'a35': -1.5708, 'a34': -1.5708, 'a33': -1.5708, 'a25': 1.5708, 'a26': 1.5708, 'a27': 1.5708, 'a28': 1.5708, 'a29': 1.5708, 'a30': 1.5708, 'a31': 1.5708, 'a32': 1.5708, 'a24': -1.5708, 'a23': -1.5708, 'a22': -1.5708, 'a21': -1.5708}.get(arg('waypoint_robot_b').lower(), -1.5708))" />
    <!-- arm robot b -->
    <arg name="launch_arm_b" default="true"/>
    <arg name="arm_model_b" default="$(arg default_arm_model)"/>
    <arg name="moveit_movegroup_b" default="true"/>
    <arg name="moveit_pipeline_b" default="ompl"/>
    <!-- gripper robot b -->
    <arg name="launch_gripper_b" default="true"/>
    <arg name="launch_camera_b" default="true"/>
    <arg name="gripper_model_b" default="$(arg default_gripper_model)"/>
    <arg name="gt_odom_topic_b" default="/$(arg id_robot_b)/robotnik_base_control/odom_gt"/>
    <arg name="gt_odom_frame_b" default="$(arg id_robot_b)_odom"/>
    <arg name="gt_base_frame_b" default="$(arg id_robot_b)_base_footprint"/>

    <!-- arguments robot c -->
    <arg name="id_robot_c" default="robot_c"/>
    <arg name="launch_robot_c" default="false"/>
    <arg name="xacro_robot_c" default="$(arg default_xacro)"/>
    <!-- spawn position robot c -->
    <arg name="x_init_pose_robot_c" default="0" />
    <arg name="y_init_pose_robot_c" default="2" />
    <arg name="z_init_pose_robot_c" default="0" />
    <arg name="yaw_init_pose_robot_c" default="0" />
    <!-- arm robot c -->
    <arg name="launch_arm_c" default="true"/>
    <arg name="arm_model_c" default="$(arg default_arm_model)"/>
    <arg name="moveit_movegroup_c" default="false"/>
    <arg name="moveit_pipeline_c" default="ompl"/>
    <!-- gripper robot c -->
    <arg name="launch_gripper_c" default="true"/>
    <arg name="launch_camera_c" default="true"/>
    <arg name="gripper_model_c" default="$(arg default_gripper_model)"/>
    <arg name="gt_odom_topic_c" default="/$(arg id_robot_c)/robotnik_base_control/odom_gt"/>
    <arg name="gt_odom_frame_c" default="$(arg id_robot_c)_odom"/>
    <arg name="gt_base_frame_c" default="$(arg id_robot_c)_base_footprint"/>


    <!-- RBKAIROS GAZEBO -->
    <include file="$(find rbkairos_gazebo)/launch/rbkairos_gazebo.launch">

        <!-- general args -->
        <arg name="launch_rviz" value="$(arg launch_rviz)"/>
        <arg name="gazebo_world" value="$(arg gazebo_world)"/>
        <arg name="ros_planar_move_plugin" value="$(arg omni_drive)"/>
        <arg name="load_arm_kinematics_file" value="$(arg load_arm_kinematics_file)"/>
        <!-- robot_a args -->
        <arg name="id_robot_a" value="$(arg id_robot_a)"/>
        <arg name="launch_robot_a" value="$(arg launch_robot_a)"/>
        <arg name="xacro_robot_a" value="$(arg xacro_robot_a)"/>
        <!-- robot_a spawn position args -->
        <arg name="x_init_pose_robot_a" value="$(arg x_init_pose_robot_a)"/>
        <arg name="y_init_pose_robot_a" value="$(arg y_init_pose_robot_a)"/>
        <arg name="z_init_pose_robot_a" value="$(arg z_init_pose_robot_a)"/>
        <arg name="yaw_init_pose_robot_a" value="$(arg yaw_init_pose_robot_a)"/>
        <!-- robot_a arm args -->
        <arg name="launch_arm_a" value="$(arg launch_arm_a)"/>
        <arg name="arm_model_a" value="$(arg arm_model_a)"/>
        <arg name="moveit_movegroup_a" value="$(arg moveit_movegroup_a)"/>
        <arg name="moveit_pipeline_a" value="$(arg moveit_pipeline_a)"/>
        <!-- robot_a gripper args -->
        <arg name="launch_gripper_a" value="$(arg launch_gripper_a)"/>
        <arg name="launch_camera_a" value="$(arg launch_camera_a)"/>
        <arg name="gripper_model_a" value="$(arg gripper_model_a)"/>

        <!-- robot_b args -->
        <arg name="id_robot_b" value="$(arg id_robot_b)"/>
        <arg name="launch_robot_b" value="$(arg launch_robot_b)"/>
        <arg name="xacro_robot_b" value="$(arg xacro_robot_b)"/>
        <!-- robot_b spawn position args -->
        <arg name="x_init_pose_robot_b" value="$(arg x_init_pose_robot_b)"/>
        <arg name="y_init_pose_robot_b" value="$(arg y_init_pose_robot_b)"/>
        <arg name="z_init_pose_robot_b" value="$(arg z_init_pose_robot_b)"/>
        <arg name="yaw_init_pose_robot_b" value="$(arg yaw_init_pose_robot_b)"/>
        <!-- robot_b arm args -->
        <arg name="launch_arm_b" value="$(arg launch_arm_b)"/>
        <arg name="arm_model_b" value="$(arg arm_model_b)"/>
        <arg name="moveit_movegroup_b" value="$(arg moveit_movegroup_b)"/>
        <arg name="moveit_pipeline_b" value="$(arg moveit_pipeline_b)"/>
        <!-- robot_b gripper args -->
        <arg name="launch_gripper_b" value="$(arg launch_gripper_b)"/>
        <arg name="gripper_model_b" value="$(arg gripper_model_b)"/>
        <arg name="launch_camera_b" value="$(arg launch_camera_b)"/>

        <!-- robot_c args -->
        <arg name="id_robot_c" value="$(arg id_robot_c)"/>
        <arg name="launch_robot_c" value="$(arg launch_robot_c)"/>
        <arg name="xacro_robot_c" value="$(arg xacro_robot_c)"/>
        <!-- robot_c spawn position args -->
        <arg name="x_init_pose_robot_c" value="$(arg x_init_pose_robot_c)"/>
        <arg name="y_init_pose_robot_c" value="$(arg y_init_pose_robot_c)"/>
        <arg name="z_init_pose_robot_c" value="$(arg z_init_pose_robot_c)"/>
        <arg name="yaw_init_pose_robot_c" value="$(arg yaw_init_pose_robot_c)"/>
        <!-- robot_c arm args -->
        <arg name="launch_arm_c" value="$(arg launch_arm_c)"/>
        <arg name="arm_model_c" value="$(arg arm_model_c)"/>
        <arg name="moveit_movegroup_c" value="$(arg moveit_movegroup_c)"/>
        <arg name="moveit_pipeline_c" value="$(arg moveit_pipeline_c)"/>
        <!-- robot_c gripper args -->
        <arg name="launch_gripper_c" value="$(arg launch_gripper_c)"/>
        <arg name="gripper_model_c" value="$(arg gripper_model_c)"/>
        <arg name="launch_camera_c" value="$(arg launch_camera_c)"/>


    </include>

    <node name="delayed_gazebo_unpause"
      pkg="rosservice"
      type="rosservice"
      args="call /gazebo/unpause_physics"
      launch-prefix="bash -c 'sleep 25; $0 $@'"
      output="screen" />

    <group if="$(arg launch_gt_odom_tf)">
        <node if="$(arg launch_robot_a)" pkg="rbkairos_sim_bringup" type="gt_odom_tf.py" name="gt_odom_tf_$(arg id_robot_a)" output="screen">
            <param name="gt_odom_topic" value="$(arg gt_odom_topic_a)"/>
            <param name="world_frame" value="$(arg gt_odom_world_frame)"/>
            <param name="odom_frame" value="$(arg gt_odom_frame_a)"/>
            <param name="base_frame" value="$(arg gt_base_frame_a)"/>
            <param name="rate" value="$(arg gt_odom_rate)"/>
        </node>

        <node if="$(arg launch_robot_b)" pkg="rbkairos_sim_bringup" type="gt_odom_tf.py" name="gt_odom_tf_$(arg id_robot_b)" output="screen">
            <param name="gt_odom_topic" value="$(arg gt_odom_topic_b)"/>
            <param name="world_frame" value="$(arg gt_odom_world_frame)"/>
            <param name="odom_frame" value="$(arg gt_odom_frame_b)"/>
            <param name="base_frame" value="$(arg gt_base_frame_b)"/>
            <param name="rate" value="$(arg gt_odom_rate)"/>
        </node>

        <node if="$(arg launch_robot_c)" pkg="rbkairos_sim_bringup" type="gt_odom_tf.py" name="gt_odom_tf_$(arg id_robot_c)" output="screen">
            <param name="gt_odom_topic" value="$(arg gt_odom_topic_c)"/>
            <param name="world_frame" value="$(arg gt_odom_world_frame)"/>
            <param name="odom_frame" value="$(arg gt_odom_frame_c)"/>
            <param name="base_frame" value="$(arg gt_base_frame_c)"/>
            <param name="rate" value="$(arg gt_odom_rate)"/>
        </node>
    </group>


</launch>
