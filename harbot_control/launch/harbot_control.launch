<?xml version="1.0"?>
<launch>
  <arg name="prefix"/>
  <arg name="ros_planar_move_plugin" default="false"/>
  <arg name="sim_arm_control" default="true"/>
  <arg name="arm_id" default="robot"/>
  <arg name="arm_controllers" default="pos_traj_controller"/> <!-- controllers can be listed seprated by a blank space -->
  <arg name="sim_gripper_control" default="false"/>
  <arg name="gripper_controllers" default="gripper_controller"/> <!-- controllers can be listed seprated by a blank space -->

  <!-- Base control -->
  <include file="$(find harbot_control)/launch/base_control.launch">
    <arg name="prefix" value="$(arg prefix)"/>
    <arg name="ros_planar_move_plugin" value="$(arg ros_planar_move_plugin)"/>
  </include>

  <!-- Container, arm and gripper control -->
  <rosparam file="$(find harbot_control)/config/container/container_bottom_controller.yaml" command="load" ns="container_bottom" subst_value="true"/>
  <node name="controller_spawner_container_bottom" pkg="controller_manager" type="spawner" respawn="false" output="screen" args="container_bottom/container_bottom_controller"/>

  <group if="$(arg sim_arm_control)">

    <rosparam file="$(find harbot_control)/config/arms/franka_controllers.yaml" command="load" ns="arm" subst_value="true"/>
    <node name="controller_spawner_arm" pkg="controller_manager" type="spawner" respawn="false" output="screen" args="
      $(arg arm_controllers)
    "/>

  </group>

  <group if="$(arg sim_gripper_control)">

    <rosparam file="$(find harbot_control)/config/grippers/franka_gripper_controller.yaml" command="load" subst_value="true" ns="gripper"/>
    <node name="controller_spawner_gripper" pkg="controller_manager" type="spawner" respawn="false" output="screen" args="
      $(arg gripper_controllers)
    "/>

  </group>
</launch>
