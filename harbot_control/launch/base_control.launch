<?xml version="1.0"?>
<launch>
  <arg name="prefix"/>
  <arg name="ros_planar_move_plugin" default="false"/>

  <!-- Use Gazebo planar motion for omni wheels and a
       four-wheel differential controller for the rubber-wheel model. -->
  <rosparam file="$(find harbot_control)/config/base/robot_control.yaml"
            command="load" subst_value="true"/>

  <node if="$(arg ros_planar_move_plugin)" name="controller_spawner"
        pkg="controller_manager" type="spawner" respawn="false"
        output="screen" args="joint_read_state_controller"/>

  <node unless="$(arg ros_planar_move_plugin)" name="controller_spawner"
        pkg="controller_manager" type="spawner" respawn="false"
        output="screen" args="robotnik_base_control joint_read_state_controller"/>
</launch>
