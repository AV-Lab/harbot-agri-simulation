<launch>

  <!-- Select ompl, chomp, or pilz_industrial_motion_planner. -->
  <arg name="pipeline" default="ompl" />

  <!-- By default, we are not in debug mode -->
  <arg name="debug" default="false" />

  <!-- By default, we will load or override the robot_description -->
  <arg name="load_robot_description" default="true"/>
  <arg name="prefix" default="robot_"/>
  <arg name="fixed_frame" default="$(arg prefix)base_footprint"/>

  <arg name="use_rviz" default="true" />

  <!-- Run MoveIt against the simulation's trajectory controllers. -->
  <include file="$(find harbot_moveit)/launch/ur5_egh/move_group.launch">
    <arg name="allow_trajectory_execution" value="true"/>
    <arg name="info" value="true"/>
    <arg name="debug" value="$(arg debug)"/>
    <arg name="pipeline" value="$(arg pipeline)"/>
    <arg name="load_robot_description" value="$(arg load_robot_description)"/>
    <arg name="prefix" value="$(arg prefix)"/>
  </include>

  <!-- Run Rviz and load the default config to see the state of the move_group node -->
  <include file="$(find harbot_moveit)/launch/ur5_egh/moveit_rviz.launch" if="$(arg use_rviz)">
    <arg name="rviz_config" value="$(find harbot_moveit)/launch/ur5_egh/moveit.rviz"/>
    <arg name="debug" value="$(arg debug)"/>
    <arg name="fixed_frame" value="$(arg fixed_frame)"/>
  </include>

</launch>
